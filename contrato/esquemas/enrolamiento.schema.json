{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobernanza.local/contrato/enrolamiento.schema.json",
  "title": "Enrolamiento",
  "description": "El agente pide el alta directo al servidor e indica el tenant al que pertenece. No usa el correo de una persona.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contrato", "tenantSlug", "hostname", "sistema", "versionSo", "versionAgente", "cpu", "ramMb", "usuarioSesion"],
  "properties": {
    "contrato": { "const": 1 },
    "tenantSlug": { "type": "string", "minLength": 2 },
    "clave": { "type": "string", "minLength": 8, "description": "Clave de enrolamiento del tenant, si ese tenant la definió." },
    "hostname": { "type": "string", "minLength": 1 },
    "machineId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$", "description": "Identidad estable del equipo. No cambia cuando cambia el usuario de sesión." },
    "sistema": { "enum": ["windows", "macos", "linux"] },
    "versionSo": { "type": "string", "minLength": 1 },
    "versionAgente": { "type": "string", "minLength": 1 },
    "cpu": { "type": "string", "minLength": 1 },
    "ramMb": { "type": "integer", "minimum": 1 },
    "usuarioSesion": { "type": "string", "minLength": 1, "description": "Usuario de la sesión del sistema operativo." },
    "huellaCertificado": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
  }
}
